<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RaTeX.Avalonia/RaTeX.Avalonia.csproj" />
    <ProjectReference Include="../../samples/RaTeX.Avalonia.Demo/RaTeX.Avalonia.Demo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/reference/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
