<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RaTeX.Avalonia</PackageId>
    <AssemblyName>RaTeX.Avalonia</AssemblyName>
    <Description>Avalonia rendering for managed RaTeX display lists.</Description>
    <PackageDescription>Render LaTeX math in Avalonia with RaTeX, including a formula control, reusable drawing resources, bundled math fonts, and system font fallback.</PackageDescription>
    <PackageTags>$(PackageTags);avalonia</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RaTeX/RaTeX.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaTeX.Avalonia.Tests" />
  </ItemGroup>
</Project>
