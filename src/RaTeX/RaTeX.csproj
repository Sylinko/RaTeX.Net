<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RaTeX</PackageId>
    <AssemblyName>RaTeX</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Bindings to the RaTeX C ABI with immutable managed display lists.</Description>
    <PackageDescription>Unofficial .NET bindings for the RaTeX (LaTeX math layout engine), providing immutable display lists and native libraries for Windows, macOS, and Linux.</PackageDescription>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <RootNamespace>RaTeX</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <RatexNativeRuntimeIdentifier Condition="'$(RatexNativeRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RatexNativeRuntimeIdentifier>
    <RatexNativeRuntimeIdentifier Condition="'$(RatexNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RatexNativeRuntimeIdentifier>
  </PropertyGroup>

  <Target Name="RequireNativeAsset" BeforeTargets="GenerateNuspec">
    <Error Condition="'@(RatexNativeAsset)' == ''" Text="Run build/build-windows-native.ps1, build/build-mac-native.sh, or build/build-linux-native.sh before packing. Stage every required RID under runtimes/{rid}/native/." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="RaTeX.Tests" />
  </ItemGroup>

  <ItemGroup>
    <RatexNativeAsset Include="runtimes/*/native/*.dll;runtimes/*/native/*.dylib;runtimes/*/native/*.so" />
    <None Remove="runtimes/**/*" />
    <None Include="@(RatexNativeAsset)" Pack="true" PackagePath="%(Identity)" />
    <!-- Source projects copy the selected native asset beside the assembly; NuGet uses RID assets. -->
    <None Update="runtimes/$(RatexNativeRuntimeIdentifier)/native/*"
          TargetPath="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
